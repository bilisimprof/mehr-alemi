---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('yazilar', ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('tr-TR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date).toLocaleLowerCase('tr-TR');

const sceneClass = (index: number) => {
  const sequence = [
    'scene-hero-top',
    'scene-split-left',
    'scene-split-right',
    'scene-wide-under',
    'scene-portrait-left',
    'scene-portrait-right',
    'scene-narrow-left',
    'scene-panorama-under',
  ];
  return sequence[index % sequence.length];
};

const titleClass = (title: string) => {
  if (title.length >= 28) return 'title-long';
  if (title.length >= 20) return 'title-medium';
  return 'title-short';
};
---
<BaseLayout title="mehr alemi" pageClass="archive-page">
  <div class="archive-tools">
    <div class="filters" role="group" aria-label="yazı türleri">
      <button class="filter is-active" type="button" data-filter="hepsi">hepsi</button>
      <button class="filter" type="button" data-filter="şiir">şiir</button>
      <button class="filter" type="button" data-filter="düz yazı">düz yazı</button>
    </div>

    <div class="scene-counter" aria-hidden="true">
      <span class="scene-current">01</span>
      <span class="scene-divider"></span>
      <span class="scene-total">00</span>
    </div>
  </div>

  <section class="story-stream" data-visible-count="6">
    {entries.map((entry, index) => (
      <article
        class={`story-scene ${sceneClass(index)} ${entry.data.featured ? 'is-featured' : ''}`}
        data-type={entry.data.type}
        data-index={index}
      >
        <a class="scene-media" href={`/yazilar/${entry.id}/`} aria-label={entry.data.title}>
          <picture>
            {entry.data.mobileCover && (
              <source media="(max-width: 700px)" srcset={entry.data.mobileCover} />
            )}
            <img
              src={entry.data.cover}
              alt=""
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </picture>
        </a>

        <div class="scene-copy">
          <div class="scene-meta">
            <span>{entry.data.type}</span>
            <span>·</span>
            <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          </div>

          <h2 class={titleClass(entry.data.title)}>
            <a href={`/yazilar/${entry.id}/`}>{entry.data.title}</a>
          </h2>

          {entry.data.excerpt && <p>{entry.data.excerpt}</p>}

          <a class="read-link" href={`/yazilar/${entry.id}/`}>
            <span>oku</span>
          </a>
        </div>

        <div class="scene-index" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </div>
      </article>
    ))}
  </section>

  <div class="load-more-wrap">
    <button class="load-more" type="button">daha fazlasını gör</button>
  </div>

  <script>
    const scenes = Array.from(document.querySelectorAll('.story-scene'));
    const filters = Array.from(document.querySelectorAll('.filter'));
    const loadMore = document.querySelector('.load-more');
    const currentEl = document.querySelector('.scene-current');
    const totalEl = document.querySelector('.scene-total');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let activeFilter = 'hepsi';
    let limit = 6;
    let sceneObserver;
    let revealObserver;

    function matchingScenes() {
      return scenes.filter((scene) =>
        activeFilter === 'hepsi' || scene.dataset.type === activeFilter
      );
    }

    function visibleScenes() {
      return matchingScenes().filter((scene) => !scene.hidden);
    }

    function updateCounterTotal() {
      const total = visibleScenes().length;
      if (totalEl) totalEl.textContent = String(total).padStart(2, '0');
      if (currentEl && total === 0) currentEl.textContent = '00';
    }

    function setupRevealObserver() {
      revealObserver?.disconnect();

      if (reduceMotion) {
        visibleScenes().forEach((scene) => scene.classList.add('is-revealed'));
        return;
      }

      revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-revealed');
            revealObserver.unobserve(entry.target);
          });
        },
        {
          threshold: 0.12,
          rootMargin: '0px 0px -8% 0px',
        }
      );

      visibleScenes().forEach((scene) => revealObserver.observe(scene));
    }

    function setupCurrentSceneObserver() {
      sceneObserver?.disconnect();

      const activeScenes = visibleScenes();
      if (!activeScenes.length) return;

      sceneObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

          if (!visible.length) return;

          const scene = visible[0].target;
          const index = activeScenes.indexOf(scene) + 1;

          if (currentEl && index > 0) {
            currentEl.textContent = String(index).padStart(2, '0');
          }

          activeScenes.forEach((item) => {
            item.classList.toggle('is-current', item === scene);
          });
        },
        {
          threshold: [0.3, 0.48, 0.66],
          rootMargin: '-12% 0px -16% 0px',
        }
      );

      activeScenes.forEach((scene) => sceneObserver.observe(scene));
    }

    function renderArchive() {
      const matches = matchingScenes();

      scenes.forEach((scene) => {
        scene.hidden = true;
        scene.classList.remove('is-revealed', 'is-current');
      });

      matches.slice(0, limit).forEach((scene) => {
        scene.hidden = false;
      });

      if (loadMore) {
        loadMore.hidden = matches.length <= limit;
      }

      updateCounterTotal();
      setupRevealObserver();
      setupCurrentSceneObserver();
      scheduleParallax();
    }

    filters.forEach((button) => {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.filter || 'hepsi';
        limit = 6;
        filters.forEach((b) => b.classList.toggle('is-active', b === button));
        renderArchive();

        if (!reduceMotion) {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          window.scrollTo(0, 0);
        }
      });
    });

    loadMore?.addEventListener('click', () => {
      limit += 6;
      renderArchive();
    });

    // Hafif parallax: yalnızca transform kullanır, requestAnimationFrame ile throttle edilir.
    let ticking = false;

    function updateParallax() {
      ticking = false;
      if (reduceMotion || window.innerWidth < 761) return;

      const viewportCenter = window.innerHeight / 2;

      visibleScenes().forEach((scene) => {
        const media = scene.querySelector('.scene-media img');
        if (!media) return;

        const rect = scene.getBoundingClientRect();
        if (rect.bottom < -100 || rect.top > window.innerHeight + 100) return;

        const sceneCenter = rect.top + rect.height / 2;
        const distance = (sceneCenter - viewportCenter) / window.innerHeight;
        const translate = Math.max(-14, Math.min(14, distance * -12));

        media.style.setProperty('--parallax-y', `${translate}px`);
      });
    }

    function scheduleParallax() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateParallax);
    }

    window.addEventListener('scroll', scheduleParallax, { passive: true });
    window.addEventListener('resize', scheduleParallax);

    renderArchive();
  </script>
</BaseLayout>
